# Cache-Control headers for static assets

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/mds/*
  Cache-Control: public, max-age=86400

/data/*
  Cache-Control: public, max-age=3600

/manifest.json
  Cache-Control: public, max-age=3600

/favicon.ico
  Cache-Control: public, max-age=86400

/logo.svg
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: no-cache
